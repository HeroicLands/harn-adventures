{
    "name": "harn-adventures",
    "version": "0.1.0",
    "private": true,
    "description": "Hârn Adventures — seventeen fan-written HârnWorld works as fourteen Foundry VTT adventures",
    "license": "CC-BY-NC-SA-4.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HeroicLands/harn-adventures.git"
    },
    "bugs": {
        "url": "https://github.com/HeroicLands/harn-adventures/issues"
    },
    "homepage": "https://github.com/HeroicLands/harn-adventures#readme",
    "type": "module",
    "scripts": {
        "clean": "package-build clean",
        "distclean": "package-build clean --distclean",
        "build": "npm ci && npm run build:noci",
        "build:local": "npm i && npm run build:noci",
        "build:noci": "run-s build:db build:module",
        "build:db": "run-s build:assets build:compiledb",
        "build:assets": "package-build assets",
        "build:compiledb": "content-build package compile",
        "build:unpackdb": "content-build package unpack",
        "build:module": "package-build manifest",
        "build:pack-release": "package-build release",
        "push:dev": "package-build deploy dev",
        "push:qa": "package-build deploy qa",
        "push:prod": "package-build deploy prod",
        "deploy:dev": "run-s build push:dev",
        "deploy:qa": "run-s build push:qa",
        "deploy:prod": "run-s build push:prod",
        "deploy:release": "run-s build build:pack-release",
        "changeset": "changeset",
        "changeset:version": "changeset version && npm install --package-lock-only",
        "changeset:check": "changeset status --since=origin/main"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@heroiclands/package-build": "^3.2.0",
        "npm-run-all": "^4.1.5"
    }
}
